{
  "name": "slack-axi",
  "version": "0.1.0",
  "description": "Owned local read-only Slack CLI",
  "private": true,
  "type": "module",
  "bin": {
    "slack-axi": "bin/slack-axi"
  },
  "files": [
    "bin",
    "dist",
    "skills/slack-axi",
    "README.md"
  ],
  "engines": {
    "node": "v26.13.0"
  },
  "volta": {
    "node": "24.22.2"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --outdir=dist && chmod +x bin/slack-axi",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/__tests__/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@toon-format/toon": "4.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
